# OCAP System 环境变量示例
# 复制为 .env 并按需修改。生产环境请使用强随机值。

# ===== 应用 =====
APP_ENV=development
APP_NAME=ocap
DEBUG=true
SECRET_KEY=please-change-me-to-a-strong-random-string-at-least-64-bytes
BASE_URL=http://127.0.0.1:8000

# ===== 鉴权 JWT (RS256) =====
JWT_ALGORITHM=HS256
JWT_SECRET=dev-only-jwt-secret-change-in-production
# 生产建议改为 RS256，并配置 PEM 文件：
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PEM_PATH=./config/jwt_private.pem
# JWT_PUBLIC_KEY_PEM_PATH=./config/jwt_public.pem
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# ===== 数据库 (PostgreSQL 生产 / SQLite 内存 开发) =====
# 开发默认 SQLite 内存，不需要任何外部服务
DATABASE_URL=sqlite+aiosqlite:///:memory:?cache=shared
# 生产 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://ocap:STRONG_PASSWORD@127.0.0.1:5432/ocap_db
# 测试：
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:?cache=shared

# 旧字段（兼容）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ocap
POSTGRES_PASSWORD=ocap
POSTGRES_DB=ocap_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis（可选；未配置时自动降级为内存实现）=====
# REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ===== 对象存储 S3 兼容（MinIO 本地 / 生产 S3）=====
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=ocap
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_SECURE=false

# ===== 三方集成模式 =====
# mock = 全部走本地 FakeStore，0 外部依赖（开发 / 测试推荐）
# real = 按 integration_configs 表配置的真实端点调用
INTEGRATION_DEFAULT_MODE=mock

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=json
